# Copy this file to Makefile.local (gitignored) and fill in your own
# Apple Developer Team ID and target iPhone UDID. Used by the ios-build-device,
# ios-deploy-device, ios-archive and ios-export-appstore Makefile targets.
#
#   cp Makefile.local.example Makefile.local
#
# DEVELOPMENT_TEAM: found at https://developer.apple.com/account under
#   Membership, or in Xcode > Settings > Accounts > (your team) > Team ID.
# IOS_DEVICE_UDID: run `make ios-list-devices` with the iPhone connected.

DEVELOPMENT_TEAM :=
IOS_DEVICE_UDID  :=
